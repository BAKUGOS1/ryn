# Copy to .env.local. Use a dedicated development Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
APP_ORIGIN=http://localhost:4173
# No service-role key, payment or email-provider key is used in Phase 1.

# Phase 2 — optional server-only worker configuration. Disabled by default.
# Apply the monitoring migration in a dedicated development project first.
MONITORING_ENABLED=false
SUPABASE_SECRET_KEY=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Exact hosts you own or have explicit permission to monitor, comma-separated.
MONITOR_ALLOWED_HOSTS=

# Signed webhooks + deadline reminders. Execution remains disabled by default.
AUTOMATION_ENABLED=false
# Server-only 32-byte encryption keyring: {"key-id":"base64-encoded-key"}.
# Supply via your secret manager. Never commit generated keys.
WEBHOOK_ACTIVE_KEY_ID=
WEBHOOK_ENCRYPTION_KEYS=
